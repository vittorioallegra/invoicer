// Tracked config contains no owner-specific values. Resource IDs below are placeholders that
// CI replaces (scripts/render-wrangler-config.mjs) from repository variables; local dev and
// tests use local D1 emulation, so the placeholders are fine there.
//
// Secrets (set with `wrangler secret put <NAME>`, never in this file):
//   BETTER_AUTH_SECRET, SETUP_TOKEN, PEC_USERNAME, PEC_PASSWORD,
//   RESEND_API_KEY (optional: courtesy email), VAPID_PRIVATE_KEY (optional: push)
// Plain vars (owner-specific, set in the Cloudflare dashboard or via CI):
//   APP_ORIGIN, MAIL_FROM_ADDRESS, VAPID_PUBLIC_KEY, VAPID_SUBJECT,
//   PEC_IMAP_HOST / PEC_IMAP_PORT (default imaps.pec.aruba.it:993),
//   PEC_SMTP_HOST / PEC_SMTP_PORT (default smtps.pec.aruba.it:465)
// See .dev.vars.example for the full list and README for the deploy guide.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "invoicer",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-08-15",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "invoicer",
      "database_id": "__D1_DATABASE_ID__",
      "migrations_dir": "migrations"
    }
  ],
  // A single cron trigger: mailbox polling every 10 minutes. The daily jobs run from the same
  // trigger at 09:00 Europe/Rome (shouldRunDaily in src/shared/cron.ts); keep the expression in
  // sync with src/shared/cron.ts.
  "triggers": { "crons": ["*/10 * * * *"] }
}
