# Copy to .dev.vars (git-ignored) for local development. Local dev and `pnpm test` need no
# external account: the PEC mailbox, Resend and push are off or mocked unless you fill them in.
# In production set secrets with `wrangler secret put <NAME>`; never commit values.

# --- Secrets -------------------------------------------------------------------------------
# Better Auth signing secret (any long random string).
BETTER_AUTH_SECRET=local-dev-only-change-me
# Required to create the owner account on first run.
SETUP_TOKEN=local-dev-setup-token
# PEC mailbox login (the address and its single password: IMAP, SMTP and webmail share it, so
# it can read the whole mailbox and send PEC). Leave empty locally: the mock channel is used.
# In production set them with `wrangler secret put PEC_USERNAME` / `PEC_PASSWORD`.
PEC_USERNAME=
PEC_PASSWORD=
# Optional: courtesy email via Resend. Off when empty.
RESEND_API_KEY=
# Optional: Web Push. Off when empty. Private key as one-line JWK JSON; generate the pair with
# `pnpm exec pushforge vapid` (docs/notes/spike.md).
VAPID_PRIVATE_KEY=
# Temporary risk spike (step 2, removed in step 20): gate for /spike, any long random string
# (`openssl rand -base64 32`). Leave empty to keep the spike routes off.
SPIKE_SECRET=

# --- Plain vars (owner-specific) ------------------------------------------------------------
APP_ORIGIN=http://localhost:5173
MAIL_FROM_ADDRESS=
VAPID_PUBLIC_KEY=
VAPID_SUBJECT=
# PEC servers (defaults are Aruba's; leave empty to use them).
PEC_IMAP_HOST=
PEC_IMAP_PORT=
PEC_SMTP_HOST=
PEC_SMTP_PORT=
